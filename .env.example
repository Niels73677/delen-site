# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL of the store (used for Stripe redirects, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe to expose (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses RLS. Used for checkout, webhooks and order lookup.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
# SERVER ONLY. Use sk_test_… keys until you go live.
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret of your webhook endpoint (Dashboard → Developers → Webhooks,
# or the value printed by `stripe listen`).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Testing only ────────────────────────────────────────────────────────────
# Point the Stripe SDK at stripe-mock (honoured only with sk_test_ keys).
# STRIPE_API_BASE_URL=http://localhost:12111
# Local Supabase database for integration/e2e tests.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_ADMIN_EMAIL=admin@atelier.test
# E2E_ADMIN_PASSWORD=change-me
